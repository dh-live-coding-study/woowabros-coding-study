{
  "manifest_version": 3,
  "name": "Woowabros coding study collector",
  "version": "0.1.3",
  "minimum_chrome_version": "111",
  "description": "백준과 프로그래머스의 정답, 오답 제출 원문을 문제별 PR로 모읍니다.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.acmicpc.net/*", "https://acmicpc.net/*", "https://school.programmers.co.kr/*", "https://api.github.com/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "제출 수집 설정" },
  "content_scripts": [
    {
      "matches": ["https://school.programmers.co.kr/learn/courses/30/lessons/*"],
      "js": ["programmers.js"], "run_at": "document_start", "world": "MAIN"
    },
    {
      "matches": ["https://www.acmicpc.net/*", "https://acmicpc.net/*", "https://school.programmers.co.kr/learn/courses/30/lessons/*"],
      "js": ["bridge.js"], "run_at": "document_start", "world": "ISOLATED"
    }
  ]
}
